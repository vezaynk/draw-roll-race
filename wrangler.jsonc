{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "draw-roll-race",
  "main": "worker/index.js",
  "compatibility_date": "2025-09-01",
  // The game itself is static; only /api/* reaches the Worker.
  "assets": {
    "directory": "public",
    "run_worker_first": ["/api/*"]
  },
  "durable_objects": {
    "bindings": [{ "name": "ROOMS", "class_name": "RaceRoom" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["RaceRoom"] }],
  "observability": { "enabled": true }
}
