{
  "name": "draw-roll-race",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "esbuild src/client/main.ts --bundle --format=iife --target=es2020 --sourcemap --outfile=public/app.js",
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.worker.json && tsc -p tsconfig.node.json",
    "sim": "tsx tools/sim.ts",
    "test:unit": "node --import tsx --test \"tests/unit/*.test.ts\"",
    "test:e2e": "tsx tests/e2e/run.ts",
    "test": "npm run typecheck && npm run test:unit && tsx tools/sim.ts 10 10 2 && tsx tests/e2e/run.ts"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260924.1",
    "@types/node": "^26.6.2",
    "esbuild": "^0.28.2",
    "playwright": "^1.56.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "wrangler": "^4.137.0"
  },
  "dependencies": {
    "@simplewebauthn/browser": "^14.0.0",
    "@simplewebauthn/server": "^14.0.2"
  }
}
